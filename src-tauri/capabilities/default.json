{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capability",
  "windows": ["main"],
  "remote": { "urls": ["http://localhost:1420/*"] },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-maximize",
    "core:window:allow-set-focus",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "opener:default"
  ]
}
