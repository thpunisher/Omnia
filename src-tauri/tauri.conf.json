{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnia",
  "version": "0.1.0",
  "identifier": "com.omnia.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omnia",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0f0f0f"
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 360,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
